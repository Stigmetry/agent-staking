# Arc Agent Staking -- Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# Arc Testnet RPC endpoint
ARC_TESTNET_RPC=https://rpc-testnet.arc.fun

# Deployer / operator private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract addresses (set after deployment)
AGENT_STAKING_ADDRESS=0x0000000000000000000000000000000000000000

# Pre-deployed Arc stack addresses
AGENT_IDENTITY_ADDRESS=0x5Bef356f89425823FC7eebB3A6ED1A678F3b8233
AGENT_JOB_ADDRESS=0xD698d15F776279c0213444a779941e8E0Cbe5094
AGENT_MARKET_ADDRESS=0x6BAf93EB026b7BC3db651065302D1934Ad577ec1
AGENT_ORCHESTRATOR_ADDRESS=0xbA99f039b7892d9F546253444c95EDea822471b0
USDC_ADDRESS=0x3600000000000000000000000000000000000000
